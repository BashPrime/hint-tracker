{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": { "type": "string", "const": "root" },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string", "const": "pointer" }
        },
        "required": ["key", "type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "content"],
  "additionalProperties": false
}
