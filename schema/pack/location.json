{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "features": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "features"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "children"],
  "additionalProperties": false
}
